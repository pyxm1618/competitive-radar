{
  "$defs": {
    "EvidenceType": {
      "enum": [
        "snapshot_before",
        "snapshot_after",
        "screenshot",
        "page_extract",
        "changelog",
        "manual_screenshot",
        "manual_recording",
        "manual_note",
        "pdf_document"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "VerificationState": {
      "enum": [
        "unverified",
        "verified",
        "missing",
        "demo_placeholder"
      ],
      "title": "VerificationState",
      "type": "string"
    }
  },
  "description": "evidence/manual/<evidence_id>/metadata.json",
  "properties": {
    "captured_at": {
      "title": "Captured At",
      "type": "string"
    },
    "captured_by": {
      "default": "human",
      "title": "Captured By",
      "type": "string"
    },
    "competitor_id": {
      "title": "Competitor Id",
      "type": "string"
    },
    "description": {
      "default": "",
      "title": "Description",
      "type": "string"
    },
    "evidence_id": {
      "pattern": "^evm-[a-z0-9][a-z0-9_-]*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType"
    },
    "files": {
      "items": {
        "type": "string"
      },
      "title": "Files",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "related_change_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Related Change Id"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_label": {
      "minLength": 1,
      "title": "Source Label",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "topic_ids": {
      "items": {
        "type": "string"
      },
      "title": "Topic Ids",
      "type": "array"
    },
    "url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Url"
    },
    "verification_state": {
      "$ref": "#/$defs/VerificationState",
      "default": "unverified"
    }
  },
  "required": [
    "evidence_id",
    "competitor_id",
    "captured_at",
    "evidence_type",
    "title",
    "source_label"
  ],
  "title": "ManualEvidence",
  "type": "object"
}
